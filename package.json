{
  "name": "finbank-onboarding",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @finbank/web && npm run build -w @finbank/api",
    "test": "npm test -w @finbank/api && npm test -w @finbank/web",
    "typecheck": "npm run typecheck -w @finbank/api && npm run typecheck -w @finbank/web",
    "screenshots": "node scripts/screenshots.mjs",
    "sample-pdfs": "node scripts/sample-pdfs.mjs",
    "docker:up": "docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d --build"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@types/express": "4.17.21"
  },
  "devDependencies": {
    "playwright-core": "1.49.1"
  }
}