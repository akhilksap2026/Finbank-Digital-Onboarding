{
  "name": "@finbank/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts src/db/migrate.ts src/db/seed.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --packages=external && mkdir -p dist/migrations && cp src/db/migrations/*.sql dist/migrations/",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate:prod": "node dist/db/migrate.js",
    "seed:prod": "node dist/db/seed.js"
  },
  "dependencies": {
    "express": "4.21.2",
    "express-async-errors": "3.1.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "ldapts": "7.3.1",
    "multer": "1.4.5-lts.1",
    "pdfkit": "0.15.2",
    "pg": "8.13.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "20.17.10",
    "@types/pdfkit": "0.13.8",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "esbuild": "0.24.2",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}