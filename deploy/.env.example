# ---- copy to .env and fill in; never commit .env ----
POSTGRES_PASSWORD=change-me
NODE_ENV=production
JWT_SECRET=                    # openssl rand -hex 32
JWT_TTL=10h
STORAGE_ENCRYPTION_KEY=        # openssl rand -hex 32  (AES-256-GCM key for documents at rest — back it up in the HSM/vault)
RETENTION_YEARS=10             # confirm against Law 1/03 of 2026 and BRB rules (see docs/OPEN_ITEMS.md)
MAX_UPLOAD_MB=10
# Active Directory
AUTH_MODE=ldap                 # ldap | mock (development only)
LDAP_URL=ldaps://dc01.finbank.local:636
LDAP_BASE_DN=DC=finbank,DC=local
LDAP_BIND_DN=CN=svc-onboarding,OU=Service Accounts,DC=finbank,DC=local
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(sAMAccountName={{username}})
LDAP_GROUP_ROLE_MAP=GG-Onb-Clerk=clerk,GG-Onb-FieldAgent=field_agent,GG-Onb-BranchHead=branch_head,GG-Onb-Ops=operations,GG-Onb-Compliance=compliance,GG-Onb-MD=md,GG-Onb-Audit=auditor,GG-Onb-Admin=admin,GG-Onb-IT=it,GG-Onb-Digital=digital,GG-Onb-Cards=cards,GG-Onb-CS=customer_service,GG-Onb-Risk=risk
LDAP_TLS_REJECT_UNAUTHORIZED=true
# Oracle Flexcube UBS 14.0 gateway (FCUBSCustomerService / FCUBSAccService)
FLEXCUBE_MODE=soap             # soap | mock
FLEXCUBE_GATEWAY_URL=http://fcubs-gw.finbank.local:7003/FCUBSAccService/FCUBSAccService
FLEXCUBE_SOURCE=ONBOARDING
FLEXCUBE_UBSCOMP=FCUBS
FLEXCUBE_USER=ONBUSER
FLEXCUBE_TIMEOUT_MS=20000
# AML screening
AML_MODE=mock                  # mock | http (vendor to be chosen)
AML_URL=
AML_API_KEY=
